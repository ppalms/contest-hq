{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "agent": {
    "plan": {
      "description": "Strategic planning and architecture analysis without code changes",
      "mode": "primary",
      "model": "opencode/claude-opus-4-8",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "build": {
      "description": "Full development with all tools enabled for code implementation",
      "mode": "primary",
      "model": "opencode/claude-sonnet-4-6",
      "temperature": 0.3,
      "permission": {
        "task": {
          "*": "allow"
        }
      }
    }
  }
}
